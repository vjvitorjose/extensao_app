# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Variáveis de ambiente
.env
.vercel
.env*.local

# Dados gerados pelos scrapers (nao versionar conteudo de terceiros).
# O padrao ignora o conteudo, mas permite reabrir excecoes abaixo.
scripts/data/*
!scripts/data/eval/
scripts/data/eval/*
!scripts/data/eval/multilabel_study.py
!scripts/data/eval/few_shot_multilabel.jsonl
# Excecao: respostas brutas das LLMs na avaliacao (runs principais e metadados).
!scripts/data/eval/runs/
scripts/data/eval/runs/*
!scripts/data/eval/runs/deepseek_flash_compact.jsonl
!scripts/data/eval/runs/deepseek_flash_compact.meta.json
!scripts/data/eval/runs/deepseek_flash_compact.summary.json
!scripts/data/eval/runs/gemini_3_1_flash_lite_compact.jsonl
!scripts/data/eval/runs/gemini_3_1_flash_lite_compact.meta.json
!scripts/data/eval/runs/gemini_3_1_flash_lite_compact.summary.json
!scripts/data/eval/runs/ollama_qwen3_8b_compact.jsonl
!scripts/data/eval/runs/ollama_qwen3_8b_compact.meta.json
!scripts/data/eval/runs/ollama_qwen3_8b_compact.summary.json

# Cache Python
scripts/populators/__pycache__/
scripts/scrapers/__pycache__/

# Ambiente virtual dos scrapers
scripts/.venv/

# Perfil autenticado do Facebook. Contem a sessao da conta (cookies e local
# storage) no formato em que o Chromium a persiste. Nunca versionar.
scripts/scrapers/fb_profile/

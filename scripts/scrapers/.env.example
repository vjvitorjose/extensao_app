# Copie para scripts/.env e preencha. O .env ja esta no .gitignore da raiz,
# entao o conteudo nao vai para o git.
#
#   copy scripts\scrapers\.env.example scripts\.env

# Chave do Google AI Studio (https://aistudio.google.com/apikey).
# Usada pela classificacao por LLM. Sem ela o script so funciona em --setup e --probe.
GEMINI_API_KEY=

# Pagina do Facebook a ser coletada. O padrao e a pagina oficial do municipio.
FB_PAGE_URL=https://www.facebook.com/sjddoficial
